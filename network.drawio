<mxfile host="app.diagrams.net" type="device">
  <diagram id="homelab-network" name="Network">
    <mxGraphModel dx="1000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Home lab network (hover any shape or line for its specifications)" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#1f3864;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="-40" width="600" height="30" as="geometry"/></mxCell>
        <object id="n_internet" label="Internet&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;service type not recorded&lt;/font&gt;" tooltip="Internet (service type not recorded)&#xa;- Outside connection from the router.&#xa;- Type of internet service: not recorded."><mxCell style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#fffdf8;strokeColor=#5b6272;fontColor=#1d2433;fontSize=13;" vertex="1" parent="1"><mxGeometry x="215.0" y="17.0" width="170" height="46" as="geometry"/></mxCell></object>
        <object id="n_router" label="Router&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;home router, Wi-Fi 6&lt;/font&gt;" tooltip="Router (home router, Wi-Fi 6)&#xa;- Model: ASUS RT-AX86U Pro (Wi-Fi 6, one 2.5 gigabit port).&#xa;- Two gigabit copper links to the access switch, bundled as one (static link aggregation).&#xa;- 2.5 gigabit copper link to the small switch.&#xa;- Hands out addresses: lab machines use fixed addresses; other devices get one from the router, with reservations for lab devices.&#xa;- Each device has one agreed name in the router&#x27;s client list, keyed by its hardware address."><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1f3864;strokeColor=#1f3864;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="210.0" y="112.0" width="180" height="56" as="geometry"/></mxCell></object>
        <object id="n_small" label="Small switch&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;5 port 2.5 gigabit, unmanaged&lt;/font&gt;" tooltip="Small switch (5 port 2.5 gigabit, unmanaged)&#xa;- Model: TP-Link TL-SG105-M2, 5 ports at 2.5 gigabit, unmanaged (no settings, no web page).&#xa;- Uplink: the router&#x27;s 2.5 gigabit port.&#xa;- Port 1: the storage server&#x27;s onboard 2.5 gigabit port.&#xa;- Unmanaged means no separate networks, no port statistics and no logs from this switch."><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1f3864;strokeColor=#1f3864;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30.0" y="212.0" width="170" height="56" as="geometry"/></mxCell></object>
        <object id="n_wifi" label="Wi-Fi devices&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;phones, tablets, smart plugs, Pi 5&lt;/font&gt;" tooltip="Wi-Fi devices (phones, tablets, smart plugs, Pi 5)&#xa;- Wireless clients of the router, shown as one group.&#xa;- Includes the per-machine power meters (smart plugs) and the Raspberry Pi 5 sentinel, which joins over Wi-Fi.&#xa;- No cables, so not in the cable schedule."><mxCell style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#fffdf8;strokeColor=#5b6272;fontColor=#1d2433;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395.0" y="212.0" width="180" height="56" as="geometry"/></mxCell></object>
        <object id="n_access" label="Access switch&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;16 port gigabit + 2 fibre slots&lt;/font&gt;" tooltip="Access switch (16 port gigabit + 2 fibre slots)&#xa;- Model: TP-Link TL-SG2218, 16 copper gigabit ports plus 2 gigabit SFP fibre slots, smart managed.&#xa;- Ports 12 and 16: router, two cables bundled as one (static link aggregation).&#xa;- Port 17: fibre trunk to the core switch.&#xa;- Carries the remote consoles, the control laptop, the security watch laptop and household devices.&#xa;- Port mirroring: a copy of all traffic on the router link goes to port 15 for the security watch laptop.&#xa;- Loop detection on. Plain web access and Telnet off; managed over HTTPS and SSH."><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1f3864;strokeColor=#1f3864;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="150.0" y="312.0" width="300" height="56" as="geometry"/></mxCell></object>
        <object id="n_kvm1" label="Remote console&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;for Server 1 (PiKVM)&lt;/font&gt;" tooltip="Remote console (for Server 1 (PiKVM))&#xa;- PiKVM V4 Plus: keyboard, video and mouse over the network.&#xa;- Access switch port 13, speed fixed at 1 gigabit."><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffdf8;strokeColor=#9a6b3f;strokeWidth=2;fontColor=#1d2433;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20.0" y="414.0" width="170" height="52" as="geometry"/></mxCell></object>
        <object id="n_kvm2" label="Remote console&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;for Server 2 (PiKVM)&lt;/font&gt;" tooltip="Remote console (for Server 2 (PiKVM))&#xa;- PiKVM V4 Mini: keyboard, video and mouse over the network.&#xa;- Access switch port 3, 1 gigabit."><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffdf8;strokeColor=#9a6b3f;strokeWidth=2;fontColor=#1d2433;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20.0" y="484.0" width="170" height="52" as="geometry"/></mxCell></object>
        <object id="n_kvm3" label="Remote console&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;for Storage server (JetKVM)&lt;/font&gt;" tooltip="Remote console (for Storage server (JetKVM))&#xa;- JetKVM on the storage server&#x27;s graphics card output, with power and reset control wired in.&#xa;- Access switch port 7, 100 megabit."><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffdf8;strokeColor=#9a6b3f;strokeWidth=2;fontColor=#1d2433;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20.0" y="554.0" width="170" height="52" as="geometry"/></mxCell></object>
        <object id="n_kvm4" label="Remote console&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;temporary test build (PiKVM)&lt;/font&gt;" tooltip="Remote console (temporary test build (PiKVM))&#xa;- A PiKVM test build, recorded as temporary.&#xa;- Access switch port 11. Link speed: not recorded."><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffdf8;strokeColor=#9a6b3f;strokeWidth=2;fontColor=#1d2433;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20.0" y="624.0" width="170" height="52" as="geometry"/></mxCell></object>
        <object id="n_m4" label="Control laptop&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MacBook Pro, M4 Pro&lt;/font&gt;" tooltip="Control laptop (MacBook Pro, M4 Pro)&#xa;- Apple MacBook Pro 16, M4 Pro: the machine I run the lab from.&#xa;- Wired through its Thunderbolt dock to access switch port 8 at 1 gigabit."><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffdf8;strokeColor=#1f3864;strokeWidth=2;fontColor=#1d2433;fontSize=13;" vertex="1" parent="1"><mxGeometry x="417.0" y="414.0" width="176" height="52" as="geometry"/></mxCell></object>
        <object id="n_sec" label="Security watch laptop&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MSI laptop running Proxmox&lt;/font&gt;" tooltip="Security watch laptop (MSI laptop running Proxmox)&#xa;- MSI GS63VR laptop running Proxmox with Wazuh, Suricata and Zeek (security monitoring and intrusion detection).&#xa;- Management: USB network adapter on access switch port 10 at 1 gigabit.&#xa;- Capture: built-in Ethernet on access switch port 15 at 1 gigabit, receiving a mirror copy of all router traffic, both directions."><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffdf8;strokeColor=#1f3864;strokeWidth=2;fontColor=#1d2433;fontSize=13;" vertex="1" parent="1"><mxGeometry x="417.0" y="484.0" width="176" height="52" as="geometry"/></mxCell></object>
        <object id="n_house" label="Household devices&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;three TVs and a media player&lt;/font&gt;" tooltip="Household devices (three TVs and a media player)&#xa;- Not part of the lab, but they share the access switch.&#xa;- Ports 1, 5 and 6: TVs. Port 2: media player.&#xa;- Recorded speeds: ports 1 and 5 at 100 megabit; ports 2 and 6 not recorded."><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffdf8;strokeColor=#5b6272;dashed=1;fontColor=#1d2433;fontSize=13;" vertex="1" parent="1"><mxGeometry x="417.0" y="554.0" width="176" height="52" as="geometry"/></mxCell></object>
        <object id="n_core" label="Core switch&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;8 port 10 gigabit fibre&lt;/font&gt;" tooltip="Core switch (8 port 10 gigabit fibre)&#xa;- Model: TP-Link TL-SX3008F, 8 SFP+ ports at 10 gigabit, managed.&#xa;- Ports 1 to 6 and 8: servers and the training laptop over multimode fibre.&#xa;- Ports 3 and 4: storage server, bundled as one 20 gigabit link (static link aggregation).&#xa;- Port 7: 1 gigabit fibre trunk to the access switch (LACP, one member).&#xa;- Jumbo frames: maximum frame size raised to 9216 bytes, the switch maximum.&#xa;- Port labels typed on the switch: PC2_z690, PC4_z97, PC3_z490, PC3_z490, PC1_x870e, PC1_x870e, Trunk_SG2218, M5Max_Mac.&#xa;- Firmware updated in October 2026 after a management freeze; the old image is kept as a fallback."><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1f3864;strokeColor=#1f3864;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120.0" y="742.0" width="360" height="56" as="geometry"/></mxCell></object>
        <object id="n_s1" label="Server 1&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;two RTX 5080 cards&lt;/font&gt;" tooltip="Server 1 (two RTX 5080 cards)&#xa;- AMD Ryzen 9 9950X3D, two NVIDIA RTX 5080, ASUS X870E board.&#xa;- Network: Intel X520 dual 10 gigabit card, both ports on the core switch (ports 5 and 6).&#xa;- The two card ports cross over: card port 1 is on switch port 6, card port 2 on switch port 5.&#xa;- Bundling the two links is decided but not built.&#xa;- Remote console: PiKVM on access switch port 13.&#xa;- Onboard copper port: not cabled."><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffdf8;strokeColor=#1f3864;strokeWidth=2;fontColor=#1d2433;fontSize=13;" vertex="1" parent="1"><mxGeometry x="25.0" y="852.0" width="170" height="56" as="geometry"/></mxCell></object>
        <object id="n_s2" label="Server 2&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;RTX 4080&lt;/font&gt;" tooltip="Server 2 (RTX 4080)&#xa;- Intel Core i9-12900K, NVIDIA RTX 4080, ASUS Z690 board.&#xa;- Network: Intel X520 dual 10 gigabit card, one port on core switch port 1.&#xa;- Module measured: 10GBASE-SR, 850 nm, receive level about -3.2 dBm.&#xa;- Second card port unused: no free core switch port.&#xa;- Remote console: PiKVM on access switch port 3.&#xa;- Onboard copper port: not cabled."><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffdf8;strokeColor=#1f3864;strokeWidth=2;fontColor=#1d2433;fontSize=13;" vertex="1" parent="1"><mxGeometry x="215.0" y="852.0" width="170" height="56" as="geometry"/></mxCell></object>
        <object id="n_media" label="Media server&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GTX 1650, Linux desktop lab&lt;/font&gt;" tooltip="Media server (GTX 1650, Linux desktop lab)&#xa;- Intel Z97 platform (ASUS Z97-A), NVIDIA GTX 1650.&#xa;- Runs Proxmox with media sharing, a DNS filter, a network device watcher and a set of Linux desktop virtual machines.&#xa;- Network: Intel X520 single-port 10 gigabit card on core switch port 2.&#xa;- Three hardware addresses seen on that one port: the host plus guests behind its virtual bridge."><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffdf8;strokeColor=#1f3864;strokeWidth=2;fontColor=#1d2433;fontSize=13;" vertex="1" parent="1"><mxGeometry x="405.0" y="852.0" width="170" height="56" as="geometry"/></mxCell></object>
        <object id="n_storage" label="Storage server&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;twelve drives, RTX 3070&lt;/font&gt;" tooltip="Storage server (twelve drives, RTX 3070)&#xa;- Intel Core i9-10850K, 128 GB memory, NVIDIA RTX 3070, Gigabyte Z490 board.&#xa;- Runs Proxmox virtualisation with TrueNAS storage, file sync, monitoring and logging guests.&#xa;- 10 gigabit: Mellanox ConnectX-3 Pro dual-port card, both ports on core switch ports 3 and 4, bonded as one link (static aggregation on the switch, matching bond in TrueNAS).&#xa;- Which card port sits on switch port 3 and which on 4: not recorded (the bond shows one hardware address).&#xa;- 2.5 gigabit: onboard Intel I225-V copper to small switch port 1, for the host and its virtual machines.&#xa;- Remote console: JetKVM on the graphics card output, access switch port 7."><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffdf8;strokeColor=#1f3864;strokeWidth=2;fontColor=#1d2433;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120.0" y="962.0" width="170" height="56" as="geometry"/></mxCell></object>
        <object id="n_m5" label="Training laptop&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MacBook Pro, M5 Max&lt;/font&gt;" tooltip="Training laptop (MacBook Pro, M5 Max)&#xa;- Apple MacBook Pro 16, M5 Max, 128 GB unified memory.&#xa;- 10 gigabit: QNAP QNA-UC10G1SF Thunderbolt to SFP+ adapter, through its Thunderbolt dock, on core switch port 8.&#xa;- Also has a 2.5 gigabit link from its dock; where that cable plugs in is not recorded, so it is not drawn.&#xa;- Also on Wi-Fi."><mxCell style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffdf8;strokeColor=#1f3864;strokeWidth=2;fontColor=#1d2433;fontSize=13;" vertex="1" parent="1"><mxGeometry x="310.0" y="962.0" width="170" height="56" as="geometry"/></mxCell></object>
        <object id="e_e_inet" label="" tooltip="Internet link&#xa;- Router to the internet.&#xa;- Service type: not recorded."><mxCell style="endArrow=none;html=1;rounded=0;strokeColor=#5b6272;strokeWidth=2;" edge="1" parent="1" source="n_internet" target="n_router"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="63.0" as="sourcePoint"/><mxPoint x="300" y="112.0" as="targetPoint"/></mxGeometry></mxCell></object>
        <object id="e_C01" label="" tooltip="Router uplink 1 of 2&#xa;- Access switch (16 port gigabit + 2 fibre slots), Port 12  to  Router, LAN port&#xa;- Cable: Copper Ethernet (category not recorded)&#xa;- Speed: 1 Gb&#xa;- Purpose: Router uplink, bundled with C02&#xa;- Note: Static link aggregation&#xa;- Schedule row C01"><mxCell style="endArrow=none;html=1;rounded=0;strokeColor=#9a6b3f;strokeWidth=2;" edge="1" parent="1" source="n_access" target="n_router"><mxGeometry relative="1" as="geometry"><mxPoint x="288" y="312.0" as="sourcePoint"/><mxPoint x="288" y="168.0" as="targetPoint"/></mxGeometry></mxCell></object>
        <object id="e_C02" label="" tooltip="Router uplink 2 of 2&#xa;- Access switch (16 port gigabit + 2 fibre slots), Port 16  to  Router, LAN port&#xa;- Cable: Copper Ethernet (category not recorded)&#xa;- Speed: 1 Gb&#xa;- Purpose: Router uplink, bundled with C01&#xa;- Note: Static link aggregation&#xa;- Schedule row C02"><mxCell style="endArrow=none;html=1;rounded=0;strokeColor=#9a6b3f;strokeWidth=2;" edge="1" parent="1" source="n_access" target="n_router"><mxGeometry relative="1" as="geometry"><mxPoint x="312" y="312.0" as="sourcePoint"/><mxPoint x="312" y="168.0" as="targetPoint"/></mxGeometry></mxCell></object>
        <object id="e_C14" label="" tooltip="Router to small switch&#xa;- Router, 2.5 gigabit port  to  Small switch (5 port 2.5 gigabit, unmanaged), Uplink port (number not recorded)&#xa;- Cable: Copper Ethernet (category not recorded)&#xa;- Speed: 2.5 Gb&#xa;- Purpose: Router to small switch&#xa;- Schedule row C14"><mxCell style="endArrow=none;html=1;rounded=0;strokeColor=#9a6b3f;strokeWidth=3;" edge="1" parent="1" source="n_router" target="n_small"><mxGeometry relative="1" as="geometry"><mxPoint x="210.0" y="140" as="sourcePoint"/><mxPoint x="115" y="212.0" as="targetPoint"/><Array as="points"><mxPoint x="115" y="140"/></Array></mxGeometry></mxCell></object>
        <object id="e_e_wifi" label="" tooltip="Wi-Fi&#xa;- Wireless devices joined to the router.&#xa;- No cable."><mxCell style="endArrow=none;html=1;rounded=0;strokeColor=#5b6272;strokeWidth=2;dashed=1;dashPattern=5 5;" edge="1" parent="1" source="n_router" target="n_wifi"><mxGeometry relative="1" as="geometry"><mxPoint x="390.0" y="140" as="sourcePoint"/><mxPoint x="485" y="212.0" as="targetPoint"/><Array as="points"><mxPoint x="485" y="140"/></Array></mxGeometry></mxCell></object>
        <object id="e_C03" label="" tooltip="Remote console for Server 1&#xa;- Access switch (16 port gigabit + 2 fibre slots), Port 13  to  Remote console (for Server 1 (PiKVM)), Network port&#xa;- Cable: Copper Ethernet (category not recorded)&#xa;- Speed: 1 Gb&#xa;- Purpose: Remote console for Server 1&#xa;- Note: Switch port speed fixed at 1 Gb&#xa;- Schedule row C03"><mxCell style="endArrow=none;html=1;rounded=0;strokeColor=#9a6b3f;strokeWidth=2;" edge="1" parent="1" source="n_access" target="n_kvm1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="368.0" as="sourcePoint"/><mxPoint x="190.0" y="440" as="targetPoint"/><Array as="points"><mxPoint x="200" y="440"/></Array></mxGeometry></mxCell></object>
        <object id="e_C04" label="" tooltip="Remote console for Server 2&#xa;- Access switch (16 port gigabit + 2 fibre slots), Port 3  to  Remote console (for Server 2 (PiKVM)), Network port&#xa;- Cable: Copper Ethernet (category not recorded)&#xa;- Speed: 1 Gb&#xa;- Purpose: Remote console for Server 2&#xa;- Schedule row C04"><mxCell style="endArrow=none;html=1;rounded=0;strokeColor=#9a6b3f;strokeWidth=2;" edge="1" parent="1" source="n_access" target="n_kvm2"><mxGeometry relative="1" as="geometry"><mxPoint x="208" y="368.0" as="sourcePoint"/><mxPoint x="190.0" y="510" as="targetPoint"/><Array as="points"><mxPoint x="208" y="510"/></Array></mxGeometry></mxCell></object>
        <object id="e_C05" label="" tooltip="Remote console for Storage server&#xa;- Access switch (16 port gigabit + 2 fibre slots), Port 7  to  Remote console (for Storage server (JetKVM)), Network port&#xa;- Cable: Copper Ethernet (category not recorded)&#xa;- Speed: 100 Mb&#xa;- Purpose: Remote console for Storage server&#xa;- Schedule row C05"><mxCell style="endArrow=none;html=1;rounded=0;strokeColor=#9a6b3f;strokeWidth=2;" edge="1" parent="1" source="n_access" target="n_kvm3"><mxGeometry relative="1" as="geometry"><mxPoint x="216" y="368.0" as="sourcePoint"/><mxPoint x="190.0" y="580" as="targetPoint"/><Array as="points"><mxPoint x="216" y="580"/></Array></mxGeometry></mxCell></object>
        <object id="e_C06" label="" tooltip="Remote console, test build&#xa;- Access switch (16 port gigabit + 2 fibre slots), Port 11  to  Remote console (temporary test build (PiKVM)), Network port&#xa;- Cable: Copper Ethernet (category not recorded)&#xa;- Speed: not recorded&#xa;- Purpose: Remote console, temporary test build&#xa;- Schedule row C06"><mxCell style="endArrow=none;html=1;rounded=0;strokeColor=#9a6b3f;strokeWidth=2;" edge="1" parent="1" source="n_access" target="n_kvm4"><mxGeometry relative="1" as="geometry"><mxPoint x="224" y="368.0" as="sourcePoint"/><mxPoint x="190.0" y="650" as="targetPoint"/><Array as="points"><mxPoint x="224" y="650"/></Array></mxGeometry></mxCell></object>
        <object id="e_C07" label="" tooltip="Control laptop&#xa;- Access switch (16 port gigabit + 2 fibre slots), Port 8  to  Control laptop (MacBook Pro, M4 Pro), Thunderbolt dock Ethernet port&#xa;- Cable: Copper Ethernet (category not recorded)&#xa;- Speed: 1 Gb&#xa;- Purpose: Control laptop&#xa;- Schedule row C07"><mxCell style="endArrow=none;html=1;rounded=0;strokeColor=#9a6b3f;strokeWidth=2;" edge="1" parent="1" source="n_access" target="n_m4"><mxGeometry relative="1" as="geometry"><mxPoint x="376" y="368.0" as="sourcePoint"/><mxPoint x="417.0" y="440" as="targetPoint"/><Array as="points"><mxPoint x="376" y="440"/></Array></mxGeometry></mxCell></object>
        <object id="e_C08" label="" tooltip="Security laptop: management&#xa;- Access switch (16 port gigabit + 2 fibre slots), Port 10  to  Security watch laptop, USB network adapter&#xa;- Cable: Copper Ethernet (category not recorded)&#xa;- Speed: 1 Gb&#xa;- Purpose: Security watch laptop: management&#xa;- Schedule row C08"><mxCell style="endArrow=none;html=1;rounded=0;strokeColor=#9a6b3f;strokeWidth=2;" edge="1" parent="1" source="n_access" target="n_sec"><mxGeometry relative="1" as="geometry"><mxPoint x="384" y="368.0" as="sourcePoint"/><mxPoint x="417.0" y="503" as="targetPoint"/><Array as="points"><mxPoint x="384" y="503"/></Array></mxGeometry></mxCell></object>
        <object id="e_C09" label="" tooltip="Security laptop: capture&#xa;- Access switch (16 port gigabit + 2 fibre slots), Port 15  to  Security watch laptop, Built-in Ethernet port&#xa;- Cable: Copper Ethernet (category not recorded)&#xa;- Speed: 1 Gb&#xa;- Purpose: Security watch laptop: capture&#xa;- Note: Receives a mirror copy of all router traffic, both directions&#xa;- Schedule row C09"><mxCell style="endArrow=none;html=1;rounded=0;strokeColor=#9a6b3f;strokeWidth=2;dashed=1;dashPattern=2 4;" edge="1" parent="1" source="n_access" target="n_sec"><mxGeometry relative="1" as="geometry"><mxPoint x="392" y="368.0" as="sourcePoint"/><mxPoint x="417.0" y="517" as="targetPoint"/><Array as="points"><mxPoint x="392" y="517"/></Array></mxGeometry></mxCell></object>
        <object id="e_C10" label="" tooltip="Household devices&#xa;- Four copper cables, shown as one line:&#xa;- Port 1: TV, 100 Mb&#xa;- Port 2: Media player, not recorded&#xa;- Port 5: TV, 100 Mb&#xa;- Port 6: TV, not recorded&#xa;- Household devices, not part of the lab.&#xa;- Schedule rows C10 to C13"><mxCell style="endArrow=none;html=1;rounded=0;strokeColor=#9a6b3f;strokeWidth=2;" edge="1" parent="1" source="n_access" target="n_house"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="368.0" as="sourcePoint"/><mxPoint x="417.0" y="580" as="targetPoint"/><Array as="points"><mxPoint x="400" y="580"/></Array></mxGeometry></mxCell></object>
        <object id="e_F07" label="" tooltip="Fibre trunk&#xa;- Core switch (8 port 10 gigabit fibre), Port 7  to  Access switch (16 port gigabit + 2 fibre slots), Port 17 (SFP fibre slot)&#xa;- Cable: Multimode fibre OM3, 1 m, LC, 1000BASE-SX modules (TP-Link TL-SM311LM) both ends&#xa;- Speed: 1 Gb&#xa;- Purpose: Trunk: joins the 10 gigabit core switch to the access switch and router&#xa;- Note: LACP aggregation with one member each end; the second member was removed&#xa;- Switch port label: Trunk_SG2218&#xa;- Schedule row F07"><mxCell style="endArrow=none;html=1;rounded=0;strokeColor=#1f3864;strokeWidth=2;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="n_access" target="n_core"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="368.0" as="sourcePoint"/><mxPoint x="300" y="742.0" as="targetPoint"/></mxGeometry></mxCell></object>
        <object id="e_F06" label="" tooltip="Server 1 link, card port 1&#xa;- Core switch (8 port 10 gigabit fibre), Port 6  to  Server 1 (two RTX 5080 cards), Intel X520 10 gigabit card, port 1&#xa;- Cable: Multimode fibre OM3, LC to LC, 10GBASE-SR 850 nm modules&#xa;- Speed: 10 Gb&#xa;- Purpose: Data network: training traffic&#xa;- Note: Ports cross: card port 1 on switch port 6&#xa;- Switch port label: PC1_x870e&#xa;- Schedule row F06"><mxCell style="endArrow=none;html=1;rounded=0;strokeColor=#1f3864;strokeWidth=3;" edge="1" parent="1" source="n_core" target="n_s1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="798.0" as="sourcePoint"/><mxPoint x="150" y="852.0" as="targetPoint"/></mxGeometry></mxCell></object>
        <object id="e_F05" label="" tooltip="Server 1 link, card port 2&#xa;- Core switch (8 port 10 gigabit fibre), Port 5  to  Server 1 (two RTX 5080 cards), Intel X520 10 gigabit card, port 2&#xa;- Cable: Multimode fibre OM3, LC to LC, 10GBASE-SR 850 nm modules&#xa;- Speed: 10 Gb&#xa;- Purpose: Data network: training traffic&#xa;- Note: Ports cross: card port 2 on switch port 5&#xa;- Switch port label: PC1_x870e&#xa;- Schedule row F05"><mxCell style="endArrow=none;html=1;rounded=0;strokeColor=#1f3864;strokeWidth=3;" edge="1" parent="1" source="n_core" target="n_s1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="798.0" as="sourcePoint"/><mxPoint x="170" y="852.0" as="targetPoint"/></mxGeometry></mxCell></object>
        <object id="e_F01" label="" tooltip="Server 2 link&#xa;- Core switch (8 port 10 gigabit fibre), Port 1  to  Server 2 (RTX 4080), Intel X520 10 gigabit card, one of two ports&#xa;- Cable: Multimode fibre OM3, LC to LC, 10GBASE-SR 850 nm modules&#xa;- Speed: 10 Gb&#xa;- Purpose: Data network: training and storage traffic&#xa;- Note: Card&#x27;s other port unused (no free core switch port)&#xa;- Switch port label: PC2_z690&#xa;- Schedule row F01"><mxCell style="endArrow=none;html=1;rounded=0;strokeColor=#1f3864;strokeWidth=3;" edge="1" parent="1" source="n_core" target="n_s2"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="798.0" as="sourcePoint"/><mxPoint x="300" y="852.0" as="targetPoint"/></mxGeometry></mxCell></object>
        <object id="e_F02" label="" tooltip="Media server link&#xa;- Core switch (8 port 10 gigabit fibre), Port 2  to  Media server, Intel X520-SR1 10 gigabit card&#xa;- Cable: Multimode fibre, LC to LC, 10GBASE-SR 850 nm modules (fibre grade not recorded)&#xa;- Speed: 10 Gb&#xa;- Purpose: Data network: media server and its virtual machines&#xa;- Note: Host and two guests seen on this port&#xa;- Switch port label: PC4_z97&#xa;- Schedule row F02"><mxCell style="endArrow=none;html=1;rounded=0;strokeColor=#1f3864;strokeWidth=3;" edge="1" parent="1" source="n_core" target="n_media"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="798.0" as="sourcePoint"/><mxPoint x="460" y="852.0" as="targetPoint"/></mxGeometry></mxCell></object>
        <object id="e_F03" label="" tooltip="Storage server link 1 of 2&#xa;- Core switch (8 port 10 gigabit fibre), Port 3  to  Storage server, Mellanox ConnectX-3 Pro, one of two ports&#xa;- Cable: Multimode fibre OM3, LC to LC, 10GBASE-SR 850 nm modules&#xa;- Speed: 10 Gb&#xa;- Purpose: Data network: storage, bonded with F04&#xa;- Note: Static link aggregation; which card port: not recorded&#xa;- Switch port label: PC3_z490&#xa;- Schedule row F03"><mxCell style="endArrow=none;html=1;rounded=0;strokeColor=#1f3864;strokeWidth=3;" edge="1" parent="1" source="n_core" target="n_storage"><mxGeometry relative="1" as="geometry"><mxPoint x="201" y="798.0" as="sourcePoint"/><mxPoint x="201" y="962.0" as="targetPoint"/></mxGeometry></mxCell></object>
        <object id="e_F04" label="" tooltip="Storage server link 2 of 2&#xa;- Core switch (8 port 10 gigabit fibre), Port 4  to  Storage server, Mellanox ConnectX-3 Pro, the other port&#xa;- Cable: Multimode fibre OM3, LC to LC, 10GBASE-SR 850 nm modules&#xa;- Speed: 10 Gb&#xa;- Purpose: Data network: storage, bonded with F03&#xa;- Note: Static link aggregation; F03 and F04 act as one 20 Gb link&#xa;- Switch port label: PC3_z490&#xa;- Schedule row F04"><mxCell style="endArrow=none;html=1;rounded=0;strokeColor=#1f3864;strokeWidth=3;" edge="1" parent="1" source="n_core" target="n_storage"><mxGeometry relative="1" as="geometry"><mxPoint x="209" y="798.0" as="sourcePoint"/><mxPoint x="209" y="962.0" as="targetPoint"/></mxGeometry></mxCell></object>
        <object id="e_F08" label="" tooltip="Training laptop link&#xa;- Core switch (8 port 10 gigabit fibre), Port 8  to  Training laptop (MacBook Pro, M5 Max), QNAP QNA-UC10G1SF Thunderbolt to SFP+ adapter, on the laptop&#x27;s Thunderbolt dock&#xa;- Cable: Multimode fibre, LC to LC, 10GBASE-SR 850 nm modules (fibre grade not recorded)&#xa;- Speed: 10 Gb&#xa;- Purpose: Data network: training laptop&#xa;- Switch port label: M5Max_Mac&#xa;- Schedule row F08"><mxCell style="endArrow=none;html=1;rounded=0;strokeColor=#1f3864;strokeWidth=3;" edge="1" parent="1" source="n_core" target="n_m5"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="798.0" as="sourcePoint"/><mxPoint x="395" y="962.0" as="targetPoint"/></mxGeometry></mxCell></object>
        <object id="e_C15" label="" tooltip="Storage server 2.5 gigabit copper&#xa;- Small switch (5 port 2.5 gigabit, unmanaged), Port 1  to  Storage server, Onboard Intel I225-V 2.5 gigabit port&#xa;- Cable: Copper Ethernet (category not recorded)&#xa;- Speed: 2.5 Gb&#xa;- Purpose: Storage server host and its virtual machines to the router&#xa;- Note: Only wired path from the storage server&#x27;s guests to the router&#xa;- Schedule row C15"><mxCell style="endArrow=none;html=1;rounded=0;strokeColor=#9a6b3f;strokeWidth=3;" edge="1" parent="1" source="n_small" target="n_storage"><mxGeometry relative="1" as="geometry"><mxPoint x="30.0" y="240" as="sourcePoint"/><mxPoint x="120.0" y="990" as="targetPoint"/><Array as="points"><mxPoint x="8" y="240"/><mxPoint x="8" y="990"/></Array></mxGeometry></mxCell></object>
